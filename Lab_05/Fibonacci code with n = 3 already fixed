//Fibonacci code with n = 3 already fixed

#include <stdio.h>

int main()
{
    int n = 3, num1 = 0, num2 = 1, nextnum;

    printf("My name is Samriddhi Agrawal\n");
    printf("Solving Question 3\n");

    printf("Fibonacci Series\n");

    for (int i = 1; i <= n; ++i)
    {
        printf("%d ", num1);

        nextnum = num1 + num2;
        num1 = num2;
        num2 = nextnum;
    }

    return 0;
}
