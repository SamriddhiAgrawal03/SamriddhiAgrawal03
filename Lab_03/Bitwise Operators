  //Bitwise AND

#include <stdio.h>

int main()
{
    int a = 5, b = 3;

    printf("%d", a & b);

    return 0;
}


  //Bitwise OR

#include <stdio.h>

int main()
{
    int a = 5, b = 3;

    printf("%d", a | b);

    return 0;
}


  //Bitwise XOR

#include <stdio.h>

int main()
{
    int a = 5, b = 3;

    printf("%d", a ^ b);

    return 0;
}


  //Bitwise NOT

#include <stdio.h>

int main()
{
    int a = 5;

    printf("%d", ~a);

    return 0;
}


  //Bitwise LEFT SHIFT

#include <stdio.h>

int main()
{
    int a = 5;

    printf("%d", a << 1);

    return 0;
}


  //Bitwise RIGHT SHIFT

#include <stdio.h>

int main()
{
    int a = 5;

    printf("%d", a >> 1);

    return 0;
}
